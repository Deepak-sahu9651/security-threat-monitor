# =============================================
# SECURITY THREAT MONITOR - Configuration
# =============================================

# MODE: false = REAL detection (production)
#       true = DEMO mode (testing with simulated threats)
DEMO_MODE=false

# Flask Configuration
FLASK_ENV=production
DEBUG=false
SECRET_KEY=generate-a-random-key-here-min-32-chars

# CORS Configuration (restrict to your frontend URL)
CORS_ORIGINS=http://localhost:3000

# =============================================
# FAILED LOGIN DETECTION (Windows Event Log)
# =============================================
FAILED_LOGIN_ENABLED=true
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_TIME_WINDOW=300

# =============================================
# PROCESS MONITORING (psutil)
# =============================================
PROCESS_MONITORING_ENABLED=true
PROCESS_CHECK_INTERVAL=5
SUSPICIOUS_PROCESSES=mimikatz.exe,psexec.exe,nmap.exe,nc.exe,cmd.exe,powershell.exe
PROCESS_MONITORING_EXCLUDE=svchost.exe,services.exe,lsass.exe,csrss.exe

# =============================================
# NETWORK MONITORING (psutil)
# =============================================
NETWORK_MONITORING_ENABLED=true
NETWORK_CHECK_INTERVAL=5
PORT_SCAN_DETECTION_ENABLED=true
PORT_SCAN_THRESHOLD=10
PORT_SCAN_TIME_WINDOW=300

# =============================================
# DATABASE (SQLite)
# =============================================
DATABASE_PATH=./threat_monitor.db

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=INFO
LOG_FILE=./logs/threat_monitor.log

# =============================================
# ALERT RETENTION
# =============================================
ALERT_RETENTION_HOURS=24
MAX_STORED_THREATS=10000

# =============================================
# DETECTION ENGINE
# =============================================
DEDUPLICATION_WINDOW=3600
CONFIDENCE_THRESHOLD=0.6
